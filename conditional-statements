#example 3

score = int(input("Enter your score: "))
if(score >=90):
    print("grade = A")
elif(score<90 and score>=80):
    print("grade = B")
elif(score<80 and score>=70):
    print("grade = C")
elif(score<70 and score>=40):
    print("grade = D")
else:
    print("failed")